{
  "name": "walnut-farm-manager",
  "private": true,
  "version": "0.1.0",
  "description": "PUFAM — Ag Manager. Mixed-farm tools: mapping, diary, blight risk, and team coordination.",
  "type": "module",
  "//desktop": "Electron/electron-builder fields. Unused by Vite, Vitest, and Capacitor. productName drives ~/.config/PUF-AM and %APPDATA%\\PUF-AM — see Plans/NAMING.md §2; changing it strands operator data.",
  "productName": "PUF-AM",
  "main": "desktop/build/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "build:android": "powershell -Command \"$env:VITE_CAPACITOR='1'; npx vite build; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; npx cap sync android\"",
    "sync:android:lan": "powershell -ExecutionPolicy Bypass -File scripts/sync-android-lan.ps1",
    "open:android": "npx cap open android",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "lint:desktop": "tsc --noEmit -p desktop/tsconfig.json",
    "test": "vitest run",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:start": "electron .",
    "desktop:dev": "npm run build && npm run desktop:build && npm run desktop:start",
    "deploy:rules": "node scripts/deployFirestoreRules.mjs",
    "deploy:cloudrun": "powershell -ExecutionPolicy Bypass -File scripts/deploy-cloudrun.ps1"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.2",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/network": "^8.0.1",
    "@freenetorg/freenet-stdlib": "^0.3.0",
    "@noble/hashes": "^2.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tabler/icons-react": "^3.45.0",
    "@tailwindcss/vite": "^4.1.14",
    "@turf/turf": "^7.3.4",
    "@types/lodash": "^4.17.24",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.4.1",
    "bonjour-service": "^1.4.3",
    "bs58": "^6.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "firebase": "^12.10.0",
    "fmin": "^0.0.4",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "leaflet.gridlayer.googlemutant": "^0.16.0",
    "leaflet.markercluster": "^1.5.3",
    "lodash": "^4.17.23",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^6.1.1",
    "react-leaflet": "^5.0.0",
    "react-leaflet-draw": "^0.21.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0",
    "uuid": "^13.0.0",
    "vite": "^6.2.0",
    "ws": "^8.21.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet-draw": "^1.0.13",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.14.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.5",
    "firebase-admin": "^13.8.0",
    "firebase-tools": "^15.23.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.18"
  }
}

{
  "name": "puf-am-byo-weather",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=lib/index.js --external:firebase-admin --external:firebase-functions --sourcemap",
    "predeploy:guard": "node scripts/refuseHostedProject.mjs",
    "deploy": "npm run predeploy:guard && firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "esbuild": "^0.25.9",
    "express": "^4.21.2",
    "typescript": "~5.8.2"
  }
}

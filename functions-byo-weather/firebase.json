{
  "functions": [
    {
      "source": ".",
      "codebase": "byo-weather",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run predeploy:guard",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "src",
        "scripts",
        "README.md"
      ]
    }
  ]
}

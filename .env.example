# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# Client-visible published app URL (canonical: https://am.pufworks.farm — NOT the ai.studio/apps share link)
# After custom-domain cutover:
# APP_URL="https://am.pufworks.farm"
# VITE_APP_URL="https://am.pufworks.farm"
# Fallback while DNS settles: https://pufom-quby5ye5pa-ts.a.run.app

# Express API base for Capacitor / physical devices (baked in at vite build time).
# Emulator default (no env): http://10.0.2.2:3000 → host machine's npm run dev.
# Physical phone on Wi‑Fi: use your PC's LAN IP, e.g.:
# VITE_API_BASE_URL="http://192.168.1.10:3000"

# DPIRD weather API — SERVER ONLY (never VITE_ prefix; that can bake into the APK)
DPIRD_API_KEY="YOUR_DPIRD_API_KEY"

# Google Maps JavaScript API — client-visible; must be restricted in Google Cloud
# See Plans/API_KEY_SECURITY.md (package com.sentinut.farm + HTTP referrers)
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# Workshop mode: local UI without Google auth / Firestore (opt-in only — do not leave on for cloud testing)
# VITE_WORKSHOP_MODE=true
# Force login even if workshop were enabled
# VITE_REQUIRE_AUTH=true

# Mist experimental fork — shows "create offline mist farm" on login (Firebase remains default)
# VITE_MIST_EXPERIMENTAL=true

# Production UI (am.pufworks.farm) → local Freenet sidecar for /api/mist/freenet/* only.
# Default when unset on HTTPS production: http://127.0.0.1:3000
# VITE_MIST_FREENET_API="http://127.0.0.1:3000"
# Force sidecar routing in dev (optional): VITE_MIST_FREENET_LOCAL=1

# In-process Freenet peer (transport inside Express server — local sidecar / npm run dev)
# MIST_FREENET=1
# MIST_FREENET_ROOT=tmp/mist-freenet
# Cloud Run production: MIST_FREENET_DISABLED=1 (set by deploy script)

# --- Freenet 0.2 (Rust node, WebSocket API — workshop default) ---
# Transport defaults to ws02 → ws://127.0.0.1:7509/v1/contract/command when unset.
# Only set these to override:
# FREENET_TRANSPORT=ws02
# FREENET_WS_URL=ws://127.0.0.1:7509/v1/contract/command
# FREENET_WS_AUTH=                         # optional; localhost usually needs none
# FREENET_PACK_WASM=units/mist-freenet/assets/pack-contract.wasm
# FDEV_BIN=fdev                         # PUT path for ws02 transport
# FREENET_WS_PORT=7509                  # fdev --port when non-default

# --- Desktop shell / PUF Freenet Host (Plans/DESKTOP_FREENET_PLUGIN.md) ---
# Read by `npm run desktop:dev` only — a packaged app never loads .env.
# The packaged app resolves bundled binaries automatically; these are workshop overrides.
# MIST_FREENET=1                                 # also starts the Freenet host on desktop
# PUF_FREENET_BIN=/home/you/.local/bin/freenet   # outranks bundled + PATH
# PUF_FDEV_BIN=/home/you/.local/bin/fdev
# PUF_CLOUD_API_BASE=https://am.pufworks.farm    # cloud-only routes (/api/auth/*, /api/weather/*)
# FREENET_WS_PORT=7609                           # move off :7509 to spawn our own node
#                                                # alongside a workshop `freenet network`

# --- Legacy Hyphanet FCP (optional) ---
# FREENET_TRANSPORT=fcp
# FREENET_FCP_HOST=127.0.0.1
# FREENET_FCP_PORT=9481

# Live transport tests (optional):
# FREENET_LIVE_WS=1 npm test -- units/mist-freenet/freenet02-live.test.ts

# Invite PIN auth uses Firebase Admin via secrets/*-firebase-adminsdk-*.json
# (or set GOOGLE_APPLICATION_CREDENTIALS). See Plans/AUTH_INVITE_PIN.md
# FIREBASE_PROJECT_ID=gen-lang-client-0444791425
# FIRESTORE_DATABASE_ID=ai-studio-143a17d7-b431-4490-8302-3a5ff176bb96
